# SPDX-License-Identifier: GPL-3.0-or-later
#
# The single record of what this project builds against: upstream commits,
# Python dependencies and container base image.  Scripts read this file, never
# a literal copy of these values.

# The upstream commits.  One line per submodule, full 40-character SHA, so a
# wrong or truncated pin cannot hide.
#
# scripts/check-pins.sh asserts that this file still agrees with what the
# superproject records (git ls-tree HEAD <submodule>); scripts/setup.sh runs
# that check before it patches or builds, and scripts/build.sh copies these
# SHAs into out/BUILD-INFO.  A mismatch means someone moved a submodule
# pointer without saying so: fix the pointer or this file, deliberately.
#
# Branch (for a human reading this): binutils binutils-2_47-branch,
# gcc releases/gcc-16, spike main, qemu master, newlib master.

BINUTILS_SHA=00a721a246d372518eda9f4116820f87160990df
GCC_SHA=e42816fe87e0fb077874392e0445cf8da739747f
NEWLIB_SHA=06add56f7c191aec6c13967e2286d8da6700fd19
QEMU_SHA=fd127cb8026f23f9e703b980fa66906954c19e11
SPIKE_SHA=f941e3a58656a99949cc4ba6d49d935710126ba2

# The Python dependency lock and the interpreter floor.  The Makefile installs
# from PYTHON_LOCK with --require-hashes; scripts/setup.sh checks PYTHON_VERSION
# before it installs anything and scripts/build.sh records both in out/BUILD-INFO.
PYTHON_LOCK=requirements.lock
PYTHON_VERSION=3.12

# The container base image for a CI build (docs/build-and-test.md targets
# Ubuntu 24.04).  BASE_IMAGE_DIGEST is the sha256 of that exact image and stays
# empty while no image has been built or selected: an empty digest means this
# file claims no image.
BASE_IMAGE=ubuntu:24.04
BASE_IMAGE_DIGEST=
