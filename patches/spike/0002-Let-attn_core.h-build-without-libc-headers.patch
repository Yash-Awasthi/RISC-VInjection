From: Yash-Awasthi <yashawasthi12032006@gmail.com>
Date: Tue, 13 Oct 2026 14:36:19 +0530
Subject: [PATCH 2/2] Let attn_core.h build without libc headers

With ATTN_FREESTANDING it maps expf, sqrtf and INFINITY to GCC builtins, so libgcc can share the definition.
---
 riscv/attn_core.h | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/riscv/attn_core.h b/riscv/attn_core.h
index 03c0746b..8501d148 100644
--- a/riscv/attn_core.h
+++ b/riscv/attn_core.h
@@ -9,7 +9,14 @@
 #ifndef ATTN_CORE_H
 #define ATTN_CORE_H
 
+#ifdef ATTN_FREESTANDING
+/* libgcc has no libc headers; the calls still bind to libm.  */
+#define expf __builtin_expf
+#define sqrtf __builtin_sqrtf
+#define INFINITY __builtin_inff ()
+#else
 #include <math.h>
+#endif
 #include <stdint.h>
 #include "attn_abi.h"
 
