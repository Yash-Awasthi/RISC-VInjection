index ab0cbc65cfc..8c1abf7e977 100644
--- a/gcc/builtin-types.def
+++ b/gcc/builtin-types.def
@@ -898,6 +898,8 @@ DEF_FUNCTION_TYPE_4 (BT_FN_UINT_OMPFN_PTR_UINT_UINT,
 		     BT_UINT, BT_PTR_FN_VOID_PTR, BT_PTR, BT_UINT, BT_UINT)
 DEF_FUNCTION_TYPE_4 (BT_FN_VOID_PTR_WORD_WORD_PTR,
 		     BT_VOID, BT_PTR, BT_WORD, BT_WORD, BT_PTR)
+DEF_FUNCTION_TYPE_4 (BT_FN_VOID_PTR_CONST_PTR_CONST_PTR_CONST_PTR,
+		     BT_VOID, BT_PTR, BT_CONST_PTR, BT_CONST_PTR, BT_CONST_PTR)
 DEF_FUNCTION_TYPE_4 (BT_FN_VOID_SIZE_VPTR_PTR_INT, BT_VOID, BT_SIZE,
 		     BT_VOLATILE_PTR, BT_PTR, BT_INT)
 DEF_FUNCTION_TYPE_4 (BT_FN_VOID_SIZE_CONST_VPTR_PTR_INT, BT_VOID, BT_SIZE,
diff --git a/gcc/builtins.cc b/gcc/builtins.cc
index 3b0db24d4e6..649dc1ff4a7 100644
--- a/gcc/builtins.cc
+++ b/gcc/builtins.cc
@@ -110,6 +110,7 @@ static int apply_args_size (void);
 static int apply_result_size (void);
 static rtx result_vector (int, rtx);
 static void expand_builtin_prefetch (tree);
+static void expand_builtin_attn (tree);
 static rtx expand_builtin_apply_args (void);
 static rtx expand_builtin_apply_args_1 (void);
 static rtx expand_builtin_apply (rtx, rtx, rtx);
@@ -6073,6 +6074,32 @@ maybe_emit_call_builtin___clear_cache (rtx begin, rtx end)
   targetm.calls.emit_call_builtin___clear_cache (begin, end);
 }
 
+/* Expand __builtin_attn (Y, X, W, C) through IFN_ATTN when the target has
+   the attn optab, otherwise to a call to __attn in libgcc.  */
+
+static void
+expand_builtin_attn (tree exp)
+{
+  tree args[4];
+  for (unsigned i = 0; i < 4; i++)
+    args[i] = CALL_EXPR_ARG (exp, i);
+
+  if (direct_internal_fn_supported_p (IFN_ATTN, pointer_sized_int_node,
+				      OPTIMIZE_FOR_SPEED))
+    {
+      expand_internal_call (gimple_build_call_internal (IFN_ATTN, 4, args[0],
+							args[1], args[2],
+							args[3]));
+      return;
+    }
+
+  rtx ops[4];
+  for (unsigned i = 0; i < 4; i++)
+    ops[i] = convert_memory_address (Pmode, expand_normal (args[i]));
+  emit_library_call (init_one_libfunc ("__attn"), LCT_NORMAL, VOIDmode,
+		     ops[0], Pmode, ops[1], Pmode, ops[2], Pmode, ops[3], Pmode);
+}
+
 /* Expand a call to __builtin___clear_cache.  */
 
 static void
@@ -8128,6 +8155,10 @@ expand_builtin (tree exp, rtx target, rtx subtarget, machine_mode mode,
       expand_builtin___clear_cache (exp);
       return const0_rtx;
 
+    case BUILT_IN_ATTN:
+      expand_builtin_attn (exp);
+      return const0_rtx;
+
     case BUILT_IN_CLASSIFY_TYPE:
       return expand_builtin_classify_type (exp);
 
