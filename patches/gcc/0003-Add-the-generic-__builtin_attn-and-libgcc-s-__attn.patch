index 00000000000..1eb8a03593d
--- /dev/null
+++ b/gcc/testsuite/gcc.target/riscv/xattn-generic-1.c
@@ -0,0 +1,14 @@
+/* Generic __builtin_attn: one attn instruction with Xattn, at -O0 too.  */
+/* { dg-do compile } */
+/* { dg-options "-march=rv64gc_xattn -mabi=lp64d -O0" } */
+/* { dg-skip-if "" { *-*-* } { "-flto" } } */
+
+void
+f (float *y, const float *x, const void *w, const void *c)
+{
+  __builtin_attn (y, x, w, c);
+  __builtin_attn (y + 1, x, w, c);
+}
+
+/* { dg-final { scan-assembler-times "\\tattn\\t" 2 } } */
+/* { dg-final { scan-assembler-not "__attn" } } */
