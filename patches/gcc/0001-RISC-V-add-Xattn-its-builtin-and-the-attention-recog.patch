+RISCV_BUILTIN (attn_si, "attn", RISCV_BUILTIN_DIRECT_NO_TARGET, RISCV_VOID_FTYPE_VOID_PTR_CVOID_PTR_CVOID_PTR_CVOID_PTR, attn32),
