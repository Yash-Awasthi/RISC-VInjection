diff --git a/gcc/config/riscv/xattn.md b/gcc/config/riscv/xattn.md
new file mode 100644
index 00000000000..a4d5a2a2f7c
--- /dev/null
+++ b/gcc/config/riscv/xattn.md
@@ -0,0 +1,40 @@
+;; Machine description for the RISC-V Xattn extension.
+;; Copyright (C) 2026 Free Software Foundation, Inc.
+
+;; This file is part of GCC.
+
+;; GCC is free software; you can redistribute it and/or modify
+;; it under the terms of the GNU General Public License as published by
+;; the Free Software Foundation; either version 3, or (at your option)
+;; any later version.
+
+;; GCC is distributed in the hope that it will be useful,
+;; but WITHOUT ANY WARRANTY; without even the implied warranty of
+;; MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+;; GNU General Public License for more details.
+
+;; You should have received a copy of the GNU General Public License
+;; along with GCC; see the file COPYING3.  If not see
+;; <http://www.gnu.org/licenses/>.
+
+;; attn rd, rs1, rs2, rs3 reads X, the weight and configuration descriptors
+;; and every buffer they point to, and writes Y.  None of those accesses is
+;; visible through the operands, so the insn is a full memory barrier.
+(define_insn "riscv_attn_<mode>"
+  [(unspec_volatile:X [(match_operand:X 0 "register_operand" "r")
+		       (match_operand:X 1 "register_operand" "r")
+		       (match_operand:X 2 "register_operand" "r")
+		       (match_operand:X 3 "register_operand" "r")]
+		      UNSPECV_XATTN)
+   (clobber (mem:BLK (scratch)))]
+  "TARGET_XATTN"
+  "attn\t%0,%1,%2,%3"
+  [(set_attr "type" "attn")
+   (set_attr "mode" "<MODE>")])
+
+;; attn writes no register, so latency only orders it against itself.  The
+;; reservation is tune-independent, like "ghost", so every pipeline model
+;; can schedule it.
+(define_insn_reservation "xattn" 1
+  (eq_attr "type" "attn")
+  "nothing")
