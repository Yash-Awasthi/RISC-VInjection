index 0000000000..a2ce13037c
--- /dev/null
+++ b/target/riscv/tcg/insn_trans/trans_xattn.c.inc
@@ -0,0 +1,19 @@
+/*
+ * RISC-V translation routine for the Xattn extension.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+static bool trans_attn(DisasContext *ctx, arg_attn *a)
+{
+    if (!ctx->cfg_ptr->ext_xattn) {
+        return false;
+    }
+    /* The helper may raise illegal-instruction or a memory fault. */
+    decode_save_opc(ctx, 0);
+    gen_helper_attn(tcg_env, get_gpr(ctx, a->rd, EXT_ZERO),
+                    get_gpr(ctx, a->rs1, EXT_ZERO),
+                    get_gpr(ctx, a->rs2, EXT_ZERO),
+                    get_gpr(ctx, a->rs3, EXT_ZERO));
+    return true;
+}
