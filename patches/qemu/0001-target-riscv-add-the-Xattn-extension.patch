diff --git a/target/riscv/tcg/attn_helper.c b/target/riscv/tcg/attn_helper.c
new file mode 100644
index 0000000000..f750d7968e
--- /dev/null
+++ b/target/riscv/tcg/attn_helper.c
@@ -0,0 +1,76 @@
+/*
+ * RISC-V Xattn helper: one instruction computes a multi-head self-attention
+ * block.  The arithmetic is attn_core.h, shared with Spike and the tests.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "cpu.h"
+#include "internals.h"
+#include "exec/helper-proto.h"
+#include "accel/tcg/cpu-ldst.h"
+#include "attn_core.h"
+
+typedef struct {
+    CPURISCVState *env;
+    uintptr_t ra;
+} AttnCtx;
+
+static uint16_t attn_ld16(void *p, uint64_t a)
+{
+    AttnCtx *c = p;
+    return cpu_lduw_le_data_ra(c->env, adjust_addr(c->env, a), c->ra);
+}
+
+static uint32_t attn_ld32(void *p, uint64_t a)
+{
+    AttnCtx *c = p;
+    return cpu_ldl_le_data_ra(c->env, adjust_addr(c->env, a), c->ra);
+}
+
+static uint64_t attn_ld64(void *p, uint64_t a)
+{
+    AttnCtx *c = p;
+    return cpu_ldq_le_data_ra(c->env, adjust_addr(c->env, a), c->ra);
+}
+
+static void attn_st16(void *p, uint64_t a, uint16_t v)
+{
+    AttnCtx *c = p;
+    cpu_stw_le_data_ra(c->env, adjust_addr(c->env, a), v, c->ra);
+}
+
+static void attn_st32(void *p, uint64_t a, uint32_t v)
+{
+    AttnCtx *c = p;
+    cpu_stl_le_data_ra(c->env, adjust_addr(c->env, a), v, c->ra);
+}
+
+void helper_attn(CPURISCVState *env, target_ulong y, target_ulong x,
+                 target_ulong wa, target_ulong ca)
+{
+    /*
+     * A guest fault longjmps out of attn_execute, so the scratch buffer is
+     * a grow-only per-thread allocation rather than a local one.
+     */
+    static __thread float *scratch;
+    static __thread uint64_t scratch_len;
+    AttnCtx ctx = { env, GETPC() };
+    struct attn_mem m = { &ctx, attn_ld16, attn_ld32, attn_ld64,
+                          attn_st16, attn_st32 };
+    struct attn_weights w;
+    struct attn_cfg c;
+    uint64_t floats;
+
+    attn_read_desc(&m, wa, ca, &w, &c);
+    floats = attn_scratch_floats(&c, &w, riscv_cpu_xlen(env));
+    if (!floats) {
+        riscv_raise_exception(env, RISCV_EXCP_ILLEGAL_INST, GETPC());
+    }
+    if (scratch_len < floats) {
+        scratch = g_renew(float, scratch, floats);
+        scratch_len = floats;
+    }
+    attn_execute(&m, y, x, &w, &c, scratch);
+}
diff --git a/target/riscv/tcg/insn_trans/trans_xattn.c.inc b/target/riscv/tcg/insn_trans/trans_xattn.c.inc
