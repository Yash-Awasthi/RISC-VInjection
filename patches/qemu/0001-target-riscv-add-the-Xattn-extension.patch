+#
+# Xattn: fused multi-head self-attention (custom-3, funct3 = 1, funct2 = 3).
+#
+# SPDX-License-Identifier: GPL-2.0-or-later
+#
+
+%rs3  27:5
+%rs2  20:5
+%rs1  15:5
+%rd    7:5
+
+&attn  rd rs1 rs2 rs3
+
+@r4    ..... .. ..... ..... ... ..... ....... &attn %rs3 %rs2 %rs1 %rd
+
