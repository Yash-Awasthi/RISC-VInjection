index 0000000000..b46e899b0e
--- /dev/null
+++ b/disas/riscv-xattn.c
@@ -0,0 +1,22 @@
+/*
+ * QEMU disassembler -- RISC-V Xattn extension
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "disas/riscv.h"
+#include "disas/riscv-xattn.h"
+
+static const rv_opcode_data op_attn = {
+    "attn", rv_codec_r4_m, rv_fmt_rd_rs1_rs2_rs3, NULL
+};
+
+const rv_opcode_data *decode_xattn(rv_decode *dec, rv_isa isa)
+{
+    /* custom-3, funct3 = 1, funct2 = 3 */
+    if ((dec->inst & 0x0600707f) == 0x0600107b) {
+        return &op_attn;
+    }
+    return NULL;
+}
